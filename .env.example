# Cursor API key — genera da https://cursor.com/settings → API Keys
CURSOR_API_KEY=

# Porta server chat (default 8765)
CHAT_PORT=8765

# Modalità demo senza account Cursor (risposte simulate)
# CHAT_USE_MOCK=1

# Modalità default: ask | plan | agent
CHAT_MODE=ask

# Workspace passato a `agent --workspace`
CHAT_WORKSPACE=/workspace
